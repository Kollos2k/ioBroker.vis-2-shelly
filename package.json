{
  "name": "iobroker.vis-2-shelly",
  "version": "0.0.5",
  "description": "A widget to display Shelly devices in vis-2",
  "author": {
    "name": "Kollos2k",
    "email": "kollos@vorsicht-bissig.de"
  },
  "homepage": "https://github.com/Kollos2k/ioBroker.vis-2-shelly",
  "license": "MIT",
  "keywords": [
    "shelly",
    "vis-2"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:Kollos2k/ioBroker.vis-2-shelly.git"
  },
  "engines": {
    "node": ">= 20"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@iobroker/adapter-core": "^3.3.2",
    "dev-server": "^0.2.0",
    "prop-types": "^15.8.1"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.0.0",
    "@alcalzone/release-script-plugin-iobroker": "^4.0.0",
    "@alcalzone/release-script-plugin-license": "^4.0.0",
    "@alcalzone/release-script-plugin-manual-review": "^4.0.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/adapter-react": "2.2.4",
    "@iobroker/build-tools": "^2.0.15",
    "@iobroker/eslint-config": "^2.2.0",
    "@iobroker/testing": "^5.2.2",
    "@iobroker/vis-2-widgets-react-dev": "^4.0.4",
    "@iobroker/vis-2-widgets-testing": "^1.0.6",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "@mui/styles": "^6.4.8",
    "@tsconfig/node20": "^20.1.7",
    "@types/chai": "5.2.3",
    "@types/chai-as-promised": "8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.10.1",
    "@types/proxyquire": "^1.3.31",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@types/sinon": "^21.0.0",
    "@types/sinon-chai": "4.0.0",
    "chai": "6.2.1",
    "chai-as-promised": "8.0.2",
    "eslint": "9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "mocha": "^11.7.5",
    "prettier": "^3.6.2",
    "proxyquire": "^2.1.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sinon": "^21.0.0",
    "sinon-chai": "4.0.1",
    "typescript": "5.9.3",
    "uuid": "^13.0.0"
  },
  "main": "main.ts",
  "files": [
    "admin/",
    "img/",
    "io-package.json",
    "LICENSE",
    "widgets/",
    "main.js"
  ],
  "scripts": {
    "build2": "node tasks",
    "copy-files": "node tasks --copy-files",
    "prebuild": "rimraf admin/build",
    "build_main":  "build typescript",
    "build": "build-adapter react",
    "watch": "build-adapter react --watch",
    "prebuild:react": "rimraf admin/build",
    "build:react": "build-adapter react",
    "watch:react": "build-adapter react --watch",
    "test:js": "mocha --config test/mocharc.custom.json \"{!(node_modules|test)/**/*.test.js,*.test.js,test/**/test!(PackageFiles|Startup).js}\"",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint --ext .js,.jsx .",
    "translate": "translate-adapter",
    "build:widget": "gulp",
    "translateGulp": "gulp translateAndUpdateWordsJS",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "test": "mocha ./test/*.test.js",
    "update-packages": "ncu --upgrade && cd src-widgets && ncu --upgrade && cd ..",
    "npm": "npm i && cd src-widgets && npm i -f"
  },
  "bugs": {
    "url": "https://github.com/kollos/ioBroker.vis-2-shelly/issues"
  },
  "readmeFilename": "README.md"
}
