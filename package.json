{
  "name": "iobroker.vis-2-shelly",
  "version": "0.0.5",
  "description": "A widget to display Shelly devices in vis-2",
  "author": {
    "name": "Kollos2k",
    "email": "kollos@vorsicht-bissig.de"
  },
  "homepage": "https://github.com/Kollos2k/ioBroker.vis-2-shelly",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "shelly",
    "vis-2",
    "vis-2-widget"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:Kollos2k/ioBroker.vis-2-shelly.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.2.4"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.0.0",
    "@alcalzone/release-script-plugin-iobroker": "^4.0.0",
    "@alcalzone/release-script-plugin-license": "^4.0.0",
    "@alcalzone/release-script-plugin-manual-review": "^4.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/dev-server": "^0.8.0",
    "@iobroker/testing": "^5.0.4",
    "@iobroker/vis-2-widgets-react-dev": "github:ioBroker/ioBroker.vis-2-widgets-react-dev",
    "@tsconfig/node20": "^20.1.4",
    "@tsconfig/node22": "^22.0.6",
    "@types/chai": "^4.3.19",
    "@types/chai-as-promised": "^8.0.1",
    "@types/mocha": "^10.0.8",
    "@types/node": "^20.16.0",
    "@types/proxyquire": "^1.3.31",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sinon": "^17.0.3",
    "@types/sinon-chai": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "chai": "^5.0.0",
    "chai-as-promised": "^8.0.1",
    "dev-server": "^0.2.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "mocha": "^12.0.3",
    "prettier": "^3.3.3",
    "proxyquire": "^2.1.3",
    "rimraf": "^6.0.1",
    "sinon": "^18.0.0",
    "sinon-chai": "^4.0.0",
    "typescript": "^5.5.4"
  },
  "main": "build/main.js",
  "type": "commonjs",
  "files": [
    "admin/",
    "widgets/",
    "io-package.json",
    "LICENSE",
    "build/"
  ],
  "scripts": {
    "prebuild": "rimraf build",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:widgets": "cd src-widgets && npm run build",
    "build": "npm run build:ts && npm run build:widgets",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "translate": "translate-adapter",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:package",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes"
  },
  "bugs": {
    "url": "https://github.com/Kollos2k/ioBroker.vis-2-shelly/issues"
  },
  "readmeFilename": "README.md"
}
