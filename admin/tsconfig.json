{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"outDir": "./build",
		"sourceMap": true,
		"sourceRoot": "./src",
		"noImplicitAny": false,
		"skipLibCheck": true,
		"allowJs": true,
		"resolveJsonModule": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"ignoreDeprecations": "6.0",
		"lib": ["es2018", "DOM"],
		"jsx": "react"
	},
	"include": ["./**/*.d.ts", "./**/*.jsx", "./**/*.js", "../lib/adapter-config.d.ts"],
	"exclude": ["./**/*.test.jsx", "./build/**/*"]
}
