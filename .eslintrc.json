{
	"root": true,
	"env": {
		"es6": true,
		"node": true,
		"mocha": true
	},
  	"ignorePatterns": ["node_modules/", "main/", "build/","admin/build/","widgets/"],
	"files": ["**./*.ts","src/**/*.ts"],
	"extends": ["eslint:recommended", "plugin:react/recommended"],
	"plugins": ["react", "import"],
	"settings": {
		"react": {
			"version": "detect"
		}
	},
	"rules": {
		"indent": [
			"error",
			"tab",
			{
				"SwitchCase": 1
			}
		],
		"no-console": "off",
		"no-unused-vars": "off",
		"no-var": "error",
		"no-empty": "off",
		"no-trailing-spaces": "error",
		"prefer-const": "error",
		"quotes": [
			"error",
			"double",
			{
				"avoidEscape": true,
				"allowTemplateLiterals": true
			}
		],
		"semi": ["error", "always"],
		"react/react-in-jsx-scope": "off",
		"import/prefer-default-export": "warn",
		"react/prop-types": "off"
	},
	"parserOptions": {
        "project": "./tsconfig.json",
		"ecmaVersion": "latest",
		"ecmaFeatures": {
			"jsx": true
		}
	}
}
