{
	"extends": "@tsconfig/node22/tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"jsx": "preserve",
		"allowJs": true,
		"checkJs": true,
		"outDir": "./build",
		"rootDir": "./src",
		"noEmitOnError": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"strict": true,
		"noImplicitAny": false,
		"useUnknownInCatchVariables": false,
		"skipLibCheck": true,
		"target": "ES2022",
		"sourceMap": false,
		"inlineSourceMap": false,
		"paths": {
			"@devices/*": ["./src-widgets/src/components/devices/*"]
		}
	},
	"include": ["src/main.ts", "src/**/*.ts", "src/**/*.tsx", "lib/**/*.ts", "*.d.ts"],
	"exclude": ["build/**", "node_modules/**", "widgets/**", "admin/**", "test/**", "main/**"]
}
